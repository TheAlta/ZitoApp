# FastAPI
APP_NAME=Zito
APP_ENV=local
AUTO_CREATE_TABLES=false

# PostgreSQL
DATABASE_URL=postgresql+psycopg://zito_app:CHANGE_ME@localhost:5432/zito_app

# Arvancloud AIaaS
# Keep the real key only in .env. Never commit it.
ARVAN_API_BASE_URL=https://arvancloudai.ir/gateway/models/GPT-5.4-Mini/YOUR_ENDPOINT_TOKEN/v1
ARVAN_API_KEY=replace_with_real_api_key
ARVAN_MODEL=GPT-5.4-Mini
ARVAN_TIMEOUT_SECONDS=45

# Arvan BGE-M3 embedding gateway for Zito-owned course RAG.
# The gateway URL may contain a sensitive token: keep it only in .env.
ARVAN_EMBEDDING_API_BASE_URL=https://arvancloudai.ir/gateway/models/Bge-m3/YOUR_ENDPOINT_TOKEN/v1
# Leave empty to reuse ARVAN_API_KEY, or set a dedicated embedding key.
ARVAN_EMBEDDING_API_KEY=
ARVAN_EMBEDDING_MODEL=Bge-m3
ARVAN_EMBEDDING_DIMENSIONS=3072
ARVAN_EMBEDDING_TIMEOUT_SECONDS=30
RAG_RETRIEVAL_TOP_K=3
RAG_CONTEXT_CHAR_LIMIT=4200
RAG_MIN_SIMILARITY=0.20
RAG_CHUNK_SIZE_CHARS=900
RAG_CHUNK_OVERLAP_CHARS=120
RAG_INDEX_JOB_MAX_ATTEMPTS=5
RAG_INDEX_JOB_LEASE_SECONDS=900
RAG_INDEX_WORKER_POLL_SECONDS=10

# For local development without spending tokens.
ARVAN_MOCK_AI=false

# Admin panel access. Replace these in your private .env.
ADMIN_USERNAME=zito_admin
ADMIN_PASSWORD=replace_with_strong_admin_password
ADMIN_SESSION_SECRET=replace_with_long_random_secret
ADMIN_SESSION_DAYS=3650
USER_SESSION_DAYS=3650

# OTP / sms.ir
# Local development can stay on mock mode. Real SMS is sent only when OTP_MOCK=false.
OTP_MOCK=true
OTP_CODE_DIGITS=6
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
SMSIR_API_URL=https://api.sms.ir/v1
SMSIR_API_KEY=replace_with_smsir_api_key
SMSIR_TEMPLATE_ID=replace_with_smsir_template_id
SMSIR_CODE_PARAMETER=Code
SMSIR_TIMEOUT_SECONDS=10

# Welcome SMS uses its own sms.ir key and a verified template. Keep real values private.
SMSIR_WELCOME_ENABLED=false
SMSIR_WELCOME_API_KEY=replace_with_welcome_smsir_api_key
SMSIR_WELCOME_TEMPLATE_ID=replace_with_welcome_smsir_template_id
SMSIR_WELCOME_NAME_PARAMETER=FULLNAME
